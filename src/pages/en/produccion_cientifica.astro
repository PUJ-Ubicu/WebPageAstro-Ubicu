---
import Layout from "@layouts/Layout.astro"
import CollectionList from "@components/collections/CollectionList.astro"
import { getLocalizedCollection } from "@i18n/content"
import { getLangFromUrl } from "@i18n/utils"

const lang = getLangFromUrl(Astro.url)
const entries = await getLocalizedCollection("produccion_cientifica", lang)
---

<Layout title="Scientific output">
  <CollectionList
    collectionKey="produccion_cientifica"
    lang={lang}
    entries={entries}
  />
</Layout>
