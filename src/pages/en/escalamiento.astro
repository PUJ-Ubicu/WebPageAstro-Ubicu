---
import Layout from "@layouts/Layout.astro"
import CollectionList from "@components/collections/CollectionList.astro"
import { getLocalizedCollection } from "@i18n/content"
import { getLangFromUrl } from "@i18n/utils"

const lang = getLangFromUrl(Astro.url)
const entries = await getLocalizedCollection("escalamiento", lang)
---

<Layout title="Product scaling">
  <CollectionList collectionKey="escalamiento" lang={lang} entries={entries} />
</Layout>
