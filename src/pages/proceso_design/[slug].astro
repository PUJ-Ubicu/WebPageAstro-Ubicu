---
import Layout from "@layouts/Layout.astro"
import CollectionDetail from "@components/collections/CollectionDetail.astro"
import { getLocalizedPaths } from "@i18n/content"

export async function getStaticPaths() {
  return getLocalizedPaths("proceso_design", "es")
}

const { entry, lang, isFallback } = Astro.props
---

<Layout title={entry.data.title}>
  <CollectionDetail
    entry={entry}
    lang={lang}
    collectionKey="proceso_design"
    isFallback={isFallback}
  />
</Layout>
