---
import Layout from "@layouts/Layout.astro"
import Container from "@components/container.astro"
import { getLangFromUrl, useTranslations, localizedPath } from "@i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout title={t("notfound.title")}>
  <Container>
    <div class="min-h-[calc(100vh-18rem)] flex items-center justify-center text-center">
      <div>
        <p class="kick">404</p>
        <h1 class="text-5xl lg:text-6xl font-bold text-navy mt-4">{t("notfound.title")}</h1>
        <p class="text-lg mt-4 text-muted">{t("notfound.p")}</p>
        <a href={localizedPath("/", lang)} class="btn btn-primary mt-8">{t("notfound.back")}</a>
      </div>
    </div>
  </Container>
</Layout>
