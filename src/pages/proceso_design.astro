---
import Layout from "@layouts/Layout.astro"
import CollectionList from "@components/collections/CollectionList.astro"
import { getLocalizedCollection } from "@i18n/content"
import { getLangFromUrl } from "@i18n/utils"

const lang = getLangFromUrl(Astro.url)
const entries = await getLocalizedCollection("proceso_design", lang)
---

<Layout title="Proceso de diseño">
  <CollectionList collectionKey="proceso_design" lang={lang} entries={entries} />
</Layout>
