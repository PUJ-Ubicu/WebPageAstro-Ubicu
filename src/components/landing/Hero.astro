---
import { getLangFromUrl, useTranslations, localizedPath } from "@i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const home = localizedPath("/", lang)
const thumb = "https://img.youtube.com/vi/NKMb4jWEmXU/maxresdefault.jpg"
---

<section class="hero" id="top">
  <div class="site-container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow reveal"><span class="dot"></span>{t("hero.eyebrow")}</span>
      <h1 class="reveal" data-d="1" set:html={t("hero.h1")} />
      <p class="lead reveal" data-d="2">{t("hero.lead")}</p>
      <div class="hero-acts reveal" data-d="3">
        <a href={localizedPath("/contact", lang)} class="btn btn-primary">{t("hero.cta1")}</a>
        <a href={`${home}#how`} class="text-link">{t("hero.cta2")}</a>
      </div>
      <div class="hero-stats reveal" data-d="4">
        <div class="stat">
          <div class="n" data-count="2">2</div>
          <div class="l">{t("hero.s1l")}</div>
        </div>
        <div class="stat">
          <div class="n" data-count="100" data-suf="%">100<span class="u">%</span></div>
          <div class="l">{t("hero.s2l")}</div>
        </div>
        <div class="stat">
          <div class="n" data-count="6" data-pre="+">+6</div>
          <div class="l">{t("hero.s3l")}</div>
        </div>
      </div>
    </div>

    <div class="hero-media reveal" data-d="2">
      <div class="breath-badge"><span></span><span></span></div>
      <div class="hero-frame" data-video-trigger role="button" tabindex="0" aria-label={t("video.play")}>
        <img src={thumb} alt="Plataforma Ubicu" loading="eager" />
        <div class="grade"></div>
        <div class="play-btn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg></div>
      </div>
    </div>
  </div>

  <div class="site-container">
    <div class="marquee reveal">
      <div class="marquee-track">
        <span>{t("marq")}</span>
        <span aria-hidden="true">{t("marq")}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 150px;
    padding-bottom: 90px;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.04fr 0.96fr;
    gap: clamp(30px, 5vw, 68px);
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(46px, 6.6vw, 82px);
    color: var(--color-navy);
    margin: 22px 0 0;
  }
  .hero :global(h1 .text-accent) {
    color: var(--color-accent);
  }
  .hero .lead {
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
    color: var(--color-muted);
    max-width: 46ch;
    margin-top: 24px;
  }
  .hero-acts {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 34px;
  }
  .hero-stats {
    display: flex;
    gap: clamp(24px, 4vw, 52px);
    margin-top: 48px;
    flex-wrap: wrap;
  }
  .hero-stats .stat .n {
    font-family: var(--font-disp);
    font-weight: 800;
    font-size: clamp(30px, 3.4vw, 40px);
    color: var(--color-navy);
    line-height: 1;
  }
  .hero-stats .stat .n :global(.u) {
    color: var(--color-accent);
  }
  .hero-stats .stat .l {
    font-size: 13px;
    color: var(--color-muted-2);
    margin-top: 7px;
    max-width: 17ch;
    line-height: 1.35;
  }

  .hero-media {
    position: relative;
  }
  .hero-frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #0b1430;
    aspect-ratio: 4 / 3.35;
    box-shadow: 0 40px 90px -36px rgba(15, 27, 61, 0.5);
    cursor: pointer;
  }
  .hero-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-frame .grade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(33, 56, 126, 0.06), rgba(15, 27, 61, 0.42));
  }
  .play-btn {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    display: grid;
    place-items: center;
    color: var(--color-navy);
    cursor: pointer;
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.35);
    transition: transform 0.3s var(--ease-brand);
  }
  .play-btn svg {
    width: 26px;
    height: 26px;
    margin-left: 4px;
  }
  .play-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.7);
    animation: ring-pulse 2.6s ease-out infinite;
  }
  .hero-frame:hover .play-btn {
    transform: translate(-50%, -50%) scale(1.07);
  }
  .breath-badge {
    position: absolute;
    top: -22px;
    right: 18px;
    width: 120px;
    height: 120px;
    pointer-events: none;
  }
  .breath-badge span {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--color-cyan) 55%, transparent);
    animation: breathe 6s ease-in-out infinite;
  }
  .breath-badge span:nth-child(2) {
    inset: 26px;
    border-color: color-mix(in srgb, var(--color-coral) 50%, transparent);
    animation-direction: reverse;
  }

  .marquee {
    margin-top: 74px;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: 18px 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-track {
    display: flex;
    gap: 54px;
    width: max-content;
    animation: marq 26s linear infinite;
  }
  .marquee-track span {
    font-family: var(--font-disp);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.06em;
    color: var(--color-muted-2);
    display: inline-flex;
    align-items: center;
    gap: 54px;
    white-space: nowrap;
  }
  .marquee-track span::after {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-cyan);
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-media {
      order: -1;
      max-width: 560px;
    }
  }
</style>
