---
import { getLangFromUrl, useTranslations } from "@i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const features = [
  { n: "01", d: "1", t: t("f1.t"), p: t("f1.d") },
  { n: "02", d: "2", t: t("f2.t"), p: t("f2.d") },
  { n: "03", d: "3", t: t("f3.t"), p: t("f3.d") },
  { n: "04", d: "1", t: t("f4.t"), p: t("f4.d") },
  { n: "05", d: "2", t: t("f5.t"), p: t("f5.d") },
  { n: "06", d: "3", t: t("f6.t"), p: t("f6.d") },
]

// Inline stroke SVGs (inherit currentColor) — ported from the prototype.
const ICONS: Record<string, string> = {
  "01": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3v3h6V3"/><path d="M9 11h4M9 15h6"/><circle cx="16.5" cy="11" r="1" fill="currentColor" stroke="none"/></svg>',
  "02": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15a8 8 0 0 1 16 0"/><path d="M12 15l4-4"/><circle cx="12" cy="15" r="1.4" fill="currentColor" stroke="none"/></svg>',
  "03": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16"/><rect x="5" y="11" width="3.4" height="6"/><rect x="10.3" y="7" width="3.4" height="10"/><rect x="15.6" y="13" width="3.4" height="4"/></svg>',
  "04": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11l8-6 8 6"/><path d="M6 10v9h12v-9"/><path d="M10 19v-5h4v5"/></svg>',
  "05": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/></svg>',
  "06": '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="12" r="2.4"/><circle cx="18" cy="6" r="2.4"/><circle cx="18" cy="18" r="2.4"/><path d="M8.1 11l7.8-4M8.1 13l7.8 4"/></svg>',
}
---

<section class="section-shell features" id="features">
  <div class="site-container">
    <div class="section-head center">
      <p class="kick reveal">{t("feat.kick")}</p>
      <h2 class="reveal" data-d="1">{t("feat.h2")}</h2>
      <p class="reveal" data-d="2">{t("feat.p")}</p>
    </div>
    <div class="feat-grid">
      {
        features.map((f) => (
          <article class="feat reveal" data-d={f.d}>
            <span class="fnum">{f.n}</span>
            <span class="icon" set:html={ICONS[f.n]} />
            <h3>{f.t}</h3>
            <p>{f.p}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    position: relative;
    background: linear-gradient(180deg, #1a2c63 0%, #152456 60%, #0f1b3d 100%);
    color: #fff;
    overflow: hidden;
  }
  .features::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(127, 208, 232, 0.08) 1px, transparent 1px);
    background-size: 30px 30px;
    opacity: 0.6;
  }
  .features .site-container {
    position: relative;
  }
  .features :global(.section-head h2) {
    color: #fff;
  }
  .features :global(.section-head .kick) {
    color: var(--color-cyan-lt);
  }
  .features :global(.section-head p) {
    color: rgba(255, 255, 255, 0.7);
  }
  .feat-grid {
    margin-top: 64px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .feat {
    position: relative;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-md);
    padding: 30px 28px 32px;
    transition:
      transform 0.4s var(--ease-brand),
      background 0.4s,
      border-color 0.4s;
  }
  .feat:hover {
    transform: translateY(-6px);
    background: rgba(255, 255, 255, 0.07);
    border-color: color-mix(in srgb, var(--color-cyan) 40%, transparent);
  }
  .feat .icon {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, color-mix(in srgb, var(--color-cyan) 26%, transparent), color-mix(in srgb, var(--color-navy) 60%, transparent));
    border: 1px solid rgba(127, 208, 232, 0.3);
    color: var(--color-cyan-lt);
    margin-bottom: 22px;
  }
  .feat:nth-child(3n + 2) .icon {
    color: var(--color-coral-soft);
    background: linear-gradient(145deg, color-mix(in srgb, var(--color-coral) 26%, transparent), color-mix(in srgb, var(--color-navy) 60%, transparent));
    border-color: color-mix(in srgb, var(--color-coral) 40%, transparent);
  }
  .feat .icon :global(svg) {
    width: 27px;
    height: 27px;
  }
  .feat .fnum {
    position: absolute;
    top: 26px;
    right: 28px;
    font-family: var(--font-disp);
    font-weight: 700;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.28);
  }
  .feat h3 {
    font-size: 21px;
    color: #fff;
    margin-bottom: 11px;
    letter-spacing: -0.01em;
  }
  .feat p {
    font-size: 15px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.68);
  }
  @media (max-width: 980px) {
    .feat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .feat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
