---
import { getLangFromUrl, useTranslations } from "@i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const poster = "https://img.youtube.com/vi/NKMb4jWEmXU/maxresdefault.jpg"
---

<section class="videosec" id="video">
  <div class="site-container">
    <div class="vhead reveal">
      <p class="kick">{t("video.kick")}</p>
      <h2>{t("video.h2")}</h2>
      <p>{t("video.p")}</p>
    </div>
  </div>
  <div class="video-stage reveal" data-d="1">
    <img class="poster" src={poster} alt="Demo de Ubicu" loading="lazy" />
    <div class="vscrim"></div>
    <div class="play-big" data-video-trigger role="button" tabindex="0" aria-label={t("video.play")}>
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
    </div>
    <div class="vlabel">{t("video.label")}</div>
  </div>
</section>

<style>
  .videosec {
    position: relative;
    background: var(--color-ink);
    color: #fff;
    padding: clamp(70px, 9vw, 120px) 0;
  }
  .vhead {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 46px;
  }
  .videosec h2 {
    font-size: clamp(34px, 4.6vw, 60px);
    color: #fff;
    margin-top: 14px;
  }
  .vhead .kick {
    color: var(--color-cyan-lt);
  }
  .vhead p {
    color: rgba(255, 255, 255, 0.72);
    font-size: 18px;
    line-height: 1.55;
    margin-top: 18px;
  }
  .video-stage {
    position: relative;
    width: min(1500px, 94vw);
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #000;
    box-shadow: 0 50px 120px -40px rgba(0, 0, 0, 0.7);
    border: 1px solid rgba(127, 208, 232, 0.16);
  }
  .video-stage img.poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.96;
  }
  .video-stage :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-stage .vscrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 60% at 50% 50%, rgba(0, 0, 0, 0.05), rgba(15, 27, 61, 0.5));
    transition: opacity 0.4s;
  }
  .video-stage .play-big {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 104px;
    height: 104px;
    border-radius: 50%;
    background: var(--color-accent);
    display: grid;
    place-items: center;
    color: #fff;
    cursor: pointer;
    box-shadow: 0 20px 60px color-mix(in srgb, var(--color-accent) 55%, transparent);
    transition: transform 0.3s var(--ease-brand);
  }
  .video-stage .play-big:hover {
    transform: translate(-50%, -50%) scale(1.06);
  }
  .video-stage .play-big svg {
    width: 34px;
    height: 34px;
    margin-left: 5px;
  }
  .video-stage .vlabel {
    position: absolute;
    left: 24px;
    bottom: 22px;
    font-family: var(--font-disp);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.04em;
    color: #fff;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(6px);
    padding: 9px 16px;
    border-radius: 999px;
  }
</style>
