---
import { Icon } from "astro-icon/components"
import Container from "@components/container.astro"
import Sectionhead from "@components/sectionhead.astro"
import Contactform from "@components/contactform.astro"
import { getLangFromUrl, useTranslations } from "@i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Container class="pb-24">
  <Sectionhead eyebrow={t("nav.contact")}>
    <Fragment slot="title">{t("contact.title")}</Fragment>
    <Fragment slot="desc">{t("contact.desc")}</Fragment>
  </Sectionhead>

  <div class="grid md:grid-cols-2 gap-12 mx-auto max-w-4xl mt-16">
    <div>
      <h2 class="font-medium text-2xl text-navy">{t("contact.h2")}</h2>
      <p class="text-lg leading-relaxed text-muted mt-3">{t("contact.lead")}</p>
      <div class="mt-6 space-y-3">
        <div class="flex items-center gap-2 text-ink">
          <Icon class="text-cyan-deep w-5 h-5" name="uil:map-marker" />
          <span>Cl. 18 #118-250, Barrio Pance, Cali, Valle del Cauca</span>
        </div>
        <div class="flex items-center gap-2 text-ink">
          <Icon class="text-cyan-deep w-5 h-5" name="uil:envelope" />
          <a class="text-link" href="mailto:ubicu.sistema@gmail.com">ubicu.sistema@gmail.com</a>
        </div>
      </div>
    </div>
    <div>
      <Contactform />
    </div>
  </div>
</Container>
