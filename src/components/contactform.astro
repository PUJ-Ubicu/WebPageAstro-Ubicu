---
import Button from "./ui/button.astro"
import { getLangFromUrl, useTranslations } from "@i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const inputClass =
  "w-full px-4 py-3 border-2 placeholder:text-muted-2 rounded-md outline-none focus:ring-2 border-line focus:border-navy ring-paper-2"
---

<!-- To make this contact form work, create your free access key from https://web3forms.com/
     Then you will get all form submissions in your email inbox. -->
<form action="https://api.web3forms.com/submit" method="POST" id="form" class="needs-validation" novalidate>
  <input type="hidden" name="access_key" value="f6fe1e23-85e4-4756-a281-f249b0833b0e" />
  <input type="checkbox" class="hidden" style="display:none" name="botcheck" />
  <div class="mb-5">
    <input type="text" placeholder={t("form.name")} required class={inputClass} name="name" />
    <div class="empty-feedback invalid-feedback text-red text-sm mt-1">{t("form.errName")}</div>
  </div>
  <div class="mb-5">
    <label for="email_address" class="sr-only">{t("form.email")}</label>
    <input id="email_address" type="email" placeholder={t("form.email")} name="email" required class={inputClass} />
    <div class="empty-feedback text-red text-sm mt-1">{t("form.errEmail")}</div>
    <div class="invalid-feedback text-red text-sm mt-1">{t("form.errEmailValid")}</div>
  </div>
  <div class="mb-3">
    <textarea name="message" required placeholder={t("form.message")} class={`${inputClass} h-36`}></textarea>
    <div class="empty-feedback invalid-feedback text-red text-sm mt-1">{t("form.errMsg")}</div>
  </div>
  <Button type="submit" size="lg" block>{t("form.send")}</Button>
  <div id="result" class="mt-3 text-center"></div>
</form>

<style>
  .invalid-feedback,
  .empty-feedback {
    display: none;
  }
  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }
  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }
  .is-invalid,
  .was-validated :invalid {
    border-color: #dc3545;
  }
</style>

<script
  is:inline
  define:vars={{ sendingText: t("form.sending"), wrongText: t("form.wrong") }}>
  const form = document.getElementById("form")
  const result = document.getElementById("result")

  form.addEventListener("submit", function (e) {
    e.preventDefault()
    form.classList.add("was-validated")
    if (!form.checkValidity()) {
      form.querySelectorAll(":invalid")[0].focus()
      return
    }
    const formData = new FormData(form)
    const object = Object.fromEntries(formData)
    const json = JSON.stringify(object)

    result.innerHTML = sendingText

    fetch("https://api.web3forms.com/submit", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Accept: "application/json",
      },
      body: json,
    })
      .then(async (response) => {
        let json = await response.json()
        if (response.status == 200) {
          result.classList.add("text-green")
          result.innerHTML = json.message
        } else {
          console.log(response)
          result.classList.add("text-red")
          result.innerHTML = json.message
        }
      })
      .catch((error) => {
        console.log(error)
        result.innerHTML = wrongText
      })
      .then(function () {
        form.reset()
        form.classList.remove("was-validated")
        setTimeout(() => {
          result.style.display = "none"
        }, 5000)
      })
  })
</script>
