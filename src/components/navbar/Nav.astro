---
import { Astronav, MenuItems, MenuIcon, Dropdown, DropdownItems } from "astro-navbar"
import { getLangFromUrl, useTranslations, localizedPath, alternatePath } from "@i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const home = localizedPath("/", lang)

const productChildren = [
  { label: t("nav.escalamiento"), href: localizedPath("/escalamiento", lang) },
  { label: t("nav.produccion"), href: localizedPath("/produccion_cientifica", lang) },
  { label: t("nav.proceso"), href: localizedPath("/proceso_design", lang) },
]

const esPath = alternatePath(Astro.url, "es")
const enPath = alternatePath(Astro.url, "en")
---

<header class="nav" id="site-nav">
  <div class="nav-inner">
    <Astronav>
      <div class="nav-bar">
        <a class="brand" href={home}>
          <img src="/ubicu-mark.svg" alt="Ubicu" width="36" height="36" />
          ubicu
        </a>
        <div class="lg:hidden flex items-center gap-3">
          <div class="lang lang-mobile" role="group" aria-label="Language">
            <a href={esPath} class:list={["lang-btn", { on: lang === "es" }]}>ES</a>
            <a href={enPath} class:list={["lang-btn", { on: lang === "en" }]}>EN</a>
          </div>
          <MenuIcon class="w-7 h-7 text-ink" />
        </div>
      </div>

      <MenuItems class="nav-menu hidden lg:flex">
        <nav class="nav-links">
          <a href={localizedPath("/about", lang)}>{t("nav.about")}</a>
          <Dropdown class="nav-dd group">
            <button class="nav-dd-btn" type="button">
              <span>{t("nav.product")}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
                class="nav-dd-caret group-open:rotate-180">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
              </svg>
            </button>
            <DropdownItems>
              <div class="nav-dd-panel">
                {productChildren.map((c) => <a href={c.href}>{c.label}</a>)}
              </div>
            </DropdownItems>
          </Dropdown>
          <a href={`${home}#how`}>{t("nav.how")}</a>
          <a href={localizedPath("/contact", lang)}>{t("nav.contact")}</a>
        </nav>
        <div class="nav-right">
          <div class="lang lang-desktop" role="group" aria-label="Language">
            <a href={esPath} class:list={["lang-btn", { on: lang === "es" }]}>ES</a>
            <a href={enPath} class:list={["lang-btn", { on: lang === "en" }]}>EN</a>
          </div>
          <a href={localizedPath("/contact", lang)} class="btn btn-primary nav-cta">{t("nav.cta")}</a>
        </div>
      </MenuItems>
    </Astronav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    transition:
      background 0.35s,
      box-shadow 0.35s,
      backdrop-filter 0.35s,
      padding 0.35s;
  }
  .nav-inner {
    max-width: var(--container-site);
    margin: 0 auto;
    padding: 18px clamp(22px, 5vw, 72px);
  }
  .nav.scrolled {
    background: color-mix(in srgb, var(--color-paper) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: 0 1px 0 var(--color-line);
  }
  .nav.scrolled .nav-inner {
    padding-block: 13px;
  }

  /* astro-navbar lays out the bar + menu; on desktop we want them inline */
  :global(.nav .astronav) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }
  @media (min-width: 1024px) {
    .nav-bar {
      width: auto;
    }
    :global(.nav .astronav) {
      width: 100%;
    }
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    font-family: var(--font-disp);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--color-navy);
    text-decoration: none;
  }
  .brand img {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: #fff;
    padding: 3px;
    box-shadow: 0 2px 10px rgba(15, 27, 61, 0.12);
  }

  .nav-menu {
    width: 100%;
  }
  @media (min-width: 1024px) {
    .nav-menu {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: auto;
      flex: 1;
      margin-left: 40px;
    }
  }

  .nav-links {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 0;
  }
  @media (min-width: 1024px) {
    .nav-links {
      flex-direction: row;
      align-items: center;
      gap: 32px;
      padding: 0;
    }
  }
  .nav-links > a,
  .nav-dd-btn {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    opacity: 0.82;
    transition:
      opacity 0.2s,
      color 0.2s;
    white-space: nowrap;
    background: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 0;
  }
  .nav-links > a:hover,
  .nav-dd-btn:hover {
    opacity: 1;
    color: var(--color-navy);
  }
  .nav-dd-caret {
    width: 12px;
    height: 12px;
    transition: transform 0.2s;
  }
  .nav-dd-panel {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px 0 8px 14px;
  }
  @media (min-width: 1024px) {
    .nav-dd {
      position: relative;
    }
    .nav-dd-panel {
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 220px;
      margin-top: 10px;
      padding: 10px;
      background: #fff;
      border: 1px solid var(--color-line);
      border-radius: var(--radius-sm);
      box-shadow: 0 18px 50px -20px rgba(15, 27, 61, 0.35);
    }
  }
  .nav-dd-panel a {
    font-size: 14.5px;
    color: var(--color-muted);
    text-decoration: none;
    padding: 7px 10px;
    border-radius: 8px;
    transition:
      color 0.2s,
      background 0.2s;
  }
  .nav-dd-panel a:hover {
    color: var(--color-navy);
    background: var(--color-paper-2);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 14px;
  }
  @media (min-width: 1024px) {
    .nav-right {
      padding-bottom: 0;
    }
  }
  .lang {
    display: inline-flex;
    background: var(--color-paper-2);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 3px;
    font-family: var(--font-disp);
    font-weight: 600;
    font-size: 12px;
  }
  .lang-desktop {
    display: none;
  }
  @media (min-width: 1024px) {
    .lang-desktop {
      display: inline-flex;
    }
  }
  .lang-btn {
    border: none;
    background: none;
    cursor: pointer;
    padding: 6px 11px;
    border-radius: 999px;
    color: var(--color-muted);
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: 0.2s;
  }
  .lang-btn.on {
    background: var(--color-navy);
    color: #fff;
  }
  .nav-cta {
    white-space: nowrap;
  }
</style>
