---
import { render, type CollectionEntry } from "astro:content"
import Container from "@components/container.astro"
import { useTranslations, localizedPath } from "@i18n/utils"
import { COLLECTION_META, type LocalizedCollection } from "@i18n/content"
import type { Lang } from "@i18n/ui"

interface Props {
  entry: CollectionEntry<LocalizedCollection>
  lang: Lang
  collectionKey: LocalizedCollection
  isFallback?: boolean
}

const { entry, lang, collectionKey } = Astro.props
const meta = COLLECTION_META[collectionKey]
const t = useTranslations(lang)
const { Content } = await render(entry)
const backHref = localizedPath(meta.listPath, lang)
---

<Container>
  <div class="mx-auto max-w-3xl mt-14">
    <span class="text-blue-400 uppercase tracking-wider text-sm font-medium">
      {entry.data.category}
    </span>
    <h1
      class="text-4xl lg:text-5xl font-bold lg:tracking-tight mt-1 lg:leading-tight">
      {entry.data.title}
    </h1>
    <div class="flex gap-2 mt-3 items-center flex-wrap md:flex-nowrap">
      <span class="text-muted-2">{entry.data.author}</span>
      <span class="text-muted-2">•</span>
      <time class="text-muted-2" datetime={entry.data.publishDate.toISOString()}>
        {entry.data.publishDate.toDateString()}
      </time>
      <span class="text-muted-2 hidden md:block">•</span>
      <div class="w-full md:w-auto flex flex-wrap gap-3">
        {
          entry.data.tags.map((tag) => (
            <span class="text-sm text-muted">#{tag}</span>
          ))
        }
      </div>
    </div>
  </div>

  <div class="mx-auto prose prose-lg mt-6 max-w-3xl">
    <Content />
  </div>
  <div class="text-center mt-8">
    <a
      href={backHref}
      class="inline-block whitespace-nowrap bg-paper-2 px-5 py-3 rounded-md hover:bg-line transition"
      >{t(meta.backKey)}</a
    >
  </div>
</Container>
