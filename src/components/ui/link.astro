---
interface Props {
  href: string
  size?: "md" | "lg"
  block?: boolean
  style?: "outline" | "primary" | "inverted" | "muted"
  class?: string
  [x: string]: any
}

const { href, block, size = "lg", style = "primary", class: className, ...rest } = Astro.props

const sizes = {
  lg: "px-6 py-3",
  md: "px-5 py-2.5",
}

const styles = {
  outline: "bg-white border-2 border-navy hover:bg-paper-2 text-navy",
  primary: "bg-accent text-white hover:bg-coral-soft border-2 border-transparent",
  inverted: "bg-white text-navy border-2 border-transparent hover:bg-paper-2",
  muted: "bg-paper-2 text-navy hover:bg-line border-2 border-transparent",
}
---

<a
  href={href}
  {...rest}
  class:list={[
    "inline-flex items-center justify-center rounded-full font-semibold text-center transition focus-visible:ring-2 ring-offset-2 ring-paper-2",
    block && "w-full",
    sizes[size],
    styles[style as keyof typeof styles],
    className,
  ]}
  ><slot />
</a>
