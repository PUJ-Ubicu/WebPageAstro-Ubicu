---
interface Props {
  size?: "md" | "lg"
  block?: boolean
  style?: "outline" | "primary" | "inverted"
  class?: string
  [x: string]: any
}

const { size = "md", style = "primary", block, class: className, ...rest } = Astro.props

const sizes = {
  md: "px-6 py-3",
  lg: "px-7 py-3.5",
}

const styles = {
  outline: "border-2 border-navy text-navy hover:bg-navy hover:text-white",
  primary: "bg-accent text-white hover:bg-coral-soft border-2 border-transparent",
  inverted: "bg-white text-navy border-2 border-transparent hover:bg-paper-2",
}
---

<button
  {...rest}
  class:list={[
    "rounded-full font-semibold text-center transition focus-visible:ring-2 ring-offset-2 ring-paper-2",
    block && "w-full",
    sizes[size],
    styles[style as keyof typeof styles],
    className,
  ]}
  ><slot />
</button>
