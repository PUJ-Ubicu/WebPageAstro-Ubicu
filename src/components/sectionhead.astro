---
const { align = "center", eyebrow } = Astro.props
---

<div class:list={["sh", align === "center" && "sh-center"]}>
  {eyebrow && <p class="kick sh-kick">{eyebrow}</p>}
  <h1 class="sh-title"><slot name="title">Title</slot></h1>
  <p class="sh-desc"><slot name="desc">Some description goes here</slot></p>
</div>

<style>
  .sh {
    margin-top: 24px;
    max-width: 760px;
  }
  .sh-center {
    margin-inline: auto;
    text-align: center;
  }
  .sh-kick {
    margin-bottom: 14px;
  }
  .sh-title {
    font-size: clamp(34px, 4.8vw, 58px);
    color: var(--color-navy);
    line-height: 1;
  }
  .sh-desc {
    font-size: clamp(17px, 1.5vw, 19px);
    line-height: 1.55;
    color: var(--color-muted);
    margin-top: 20px;
  }
</style>
