---
import { SEO } from "astro-seo"
import { fade } from "astro:transitions"
import Footer from "@components/Footer.astro"
import Nav from "@components/navbar/Nav.astro"
import SiteScripts from "@components/SiteScripts.astro"
import "../styles/global.css"
import { ClientRouter } from "astro:transitions"
import { getLangFromUrl } from "@i18n/utils"

export interface Props {
  title?: string
  description?: string
}

const lang = getLangFromUrl(Astro.url)
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString()
const resolvedImageWithDomain = new URL("/opengraph.jpg", Astro.site).toString()

const { title, description } = Astro.props
const makeTitle = title ? title + " | " + "Ubicu" : "Ubicu - Sistema incentivo respiratorio"
const desc = description ?? "Ubicu - Sistema incentivo respiratorio"
---

<!doctype html>
<html lang={lang} transition:animate={fade({ duration: "0.5s" })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/ubicu-mark.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800;900&family=Hanken+Grotesk:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Sora:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <SEO
      title={makeTitle}
      description={desc}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `Ubicu - Sistema incentivo respiratorio`,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "Ubicu Homepage Screenshot",
        },
      }}
    />
    <ClientRouter />
  </head>
  <body>
    <Nav />
    <div class="page-main">
      <slot />
    </div>
    <Footer />
    <SiteScripts />
    <style is:global>
      /* Inner pages need top spacing to clear the fixed navbar. */
      .page-main {
        padding-top: 96px;
        min-height: 60vh;
      }
    </style>
  </body>
</html>
